{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "exclude": ["tests/fixtures/consumer.tsx"],
  "include": [
    "src",
    "playground",
    "tests",
    "vite.config.ts",
    ".storybook",
    "stories",
    "vitest.storybook.config.ts"
  ]
}
